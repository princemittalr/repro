# Copy this file to .env and fill in your values. Never commit .env.

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=your-nebius-token-factory-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Model routing (exact IDs as returned by scripts/list_models.py) ---
MODEL_PERCEIVE=nvidia/Nemotron-3.5-Super-VL
MODEL_TRIAGE=nvidia/Nemotron-3_5-Lightning
MODEL_CODER=nvidia/nemotron-3-super-120b-a12b
MODEL_ESCALATE=nvidia/Nemotron-3-Ultra-550b-a55b

# --- Tavily (web research) ---
TAVILY_API_KEY=tvly-your-key

# --- GitHub (opens PRs on the demo repo) ---
GITHUB_TOKEN=github_pat_your-fine-grained-token
GITHUB_DEMO_REPO=your-username/shoplite
